{
  "name": "mor-nuxt-js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nuxt --port 3000",
    "build": "nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "lint:js": "eslint --ext \".js,.vue\" --ignore-path .gitignore .",
    "lint:prettier": "prettier --check .",
    "lint": "npm run lint:js && npm run lint:prettier",
    "lintfix": "prettier --write --list-different . && npm run lint:js -- --fix",
    "deploy": "docker-compose build && docker-compose up -d"
  },
  "lint-staged": {
    "*.{js,vue}": "eslint --cache",
    "*.**": "prettier --check --ignore-unknown"
  },
  "dependencies": {
    "@chenfengyuan/vue-qrcode": "^1.0.2",
    "@fullcalendar/bootstrap": "^6.0.2",
    "@fullcalendar/core": "^6.0.2",
    "@fullcalendar/daygrid": "^6.0.2",
    "@fullcalendar/interaction": "^6.0.2",
    "@fullcalendar/list": "^6.0.2",
    "@fullcalendar/rrule": "^6.0.2",
    "@fullcalendar/timegrid": "^6.0.2",
    "@fullcalendar/vue": "^6.0.2",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@nuxt/telemetry": "^1.3.6",
    "@nuxtjs/axios": "^5.13.6",
    "@nuxtjs/dotenv": "^1.4.1",
    "@nuxtjs/i18n": "^7.0.1",
    "@nuxtjs/style-resources": "^1.2.1",
    "bootstrap-vue": "^2.22.0",
    "core-js": "^3.15.1",
    "lodash": "^4.17.21",
    "nuxt": "^2.15.7",
    "vue-cookies": "^1.8.1",
    "vue-grid-layout": "^2.4.0",
    "vue2-datepicker": "^3.11.1",
    "vuedraggable": "^2.24.3",
    "vuejs-auto-complete": "^0.9.0",
    "vuejs-datepicker": "^1.6.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.14.7",
    "@nuxt/postcss8": "^1.1.3",
    "@nuxtjs/eslint-config": "^6.0.1",
    "@nuxtjs/eslint-module": "^3.0.2",
    "autoprefixer": "10.4.5",
    "eslint": "^7.29.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-nuxt": "^2.0.0",
    "eslint-plugin-vue": "^7.12.1",
    "highcharts": "^10.3.3",
    "highcharts-vue": "^1.4.0",
    "lint-staged": "^13.0.3",
    "postcss": "^8.4.16",
    "prettier": "^2.3.2",
    "sass": "^1.37.5",
    "sass-loader": "^10.2.0",
    "tailwindcss": "^3.1.8",
    "vue-multiselect": "^2.1.6"
  },
  "overrides": {
    "autoprefixer": "10.4.5"
  }
}
